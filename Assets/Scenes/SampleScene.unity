--- !u!114 &1843996461
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1843996460}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 204a63419e9889749a0d15c0d8dcaffa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uC18C\uB140"
    text: "\uC5B4\uB514\uC11C \uB9DB\uC788\uB294 \uB0C4\uC0C8\uAC00 \uB098\uB294\uB370..."
  - speaker: ???
    text: "\uB0B4\uAC00 \uBE75 \uC880 \uB9CC\uB4E4\uC5C8\uB294\uB370, \uBA39\uACE0
      \uAC08\uB798?"
  - speaker: "\uC18C\uB140"
    text: "\uC73C\uC557! \uAE5C\uC9DD\uC774\uC57C..."
  - speaker: "\uC18C\uB140"
    text: "\uB204\uAD6C...\uC544\uB2C8 \uADF8\uBCF4\uB2E4 \uC591\uC774 \uB9D0\uC744...?!"
  - speaker: ???
    text: "\uB0B4\uAC00 \uB9D0\uC744 \uD558\uB294\uAC8C \uC774\uC0C1\uD574?"
  - speaker: "\uC18C\uB140"
    text: "\uADF8...\uADF8\uAC74..."
  - speaker: "\uBCA0\uC774"
    text: "\uADF8\uB9AC\uACE0 \uB098\uB294 \uBCA0\uC774\uC57C. \uADF8\uB0E5 \uC591\uC774
      \uC544\uB2C8\uB77C\uAD6C."
  - speaker: "\uBCA0\uC774"
    text: "\uB108\uAC00 \uD30C\uD2F0\uC5D0 \uAC08 \uC7A5\uC18C\uB97C \uCC3E\uACE0
      \uC788\uB2E4\uB294 \uAC83\uB3C4 \uC54C\uACE0."
  - speaker: "\uC18C\uB140"
    text: "\uADF8, \uADF8\uAC78 \uC5B4\uB5BB\uAC8C \uC548\uAC70\uC57C?! \uADF8\uB7FC
      \uB124\uAC00 \uAE38\uC744 \uC54C\uB824\uC900\uB2E4\uB294..."
  - speaker: "\uBCA0\uC774"
    text: "\uD6C4\uD6C4\uD6D7, \uAE00\uC384."
  - speaker: "\uC18C\uB140"
    text: "\uC6C3\uC9C0\uB9CC  \uB9D0\uACE0 \uC54C\uB824\uC918!"
  - speaker: "\uBCA0\uC774"
    text: "\uD6C4\uD6D7"
  - speaker: "\uC18C\uB140"
    text: "\uC54C\uB824\uB2EC\uB77C\uB2C8\uAE4C!"
  prompt: {fileID: 1511905750}
  dialogueBox: {fileID: 1511905755}
