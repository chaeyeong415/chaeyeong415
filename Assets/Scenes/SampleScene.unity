  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8fa216139168d144bc22e325f5d2cdf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uB098"
    text: "\uC2E4\uB840\uD569\uB2C8\uB2E4, \uD639\uC2DC \uB098\uAC00\uB294 \uAE38\uC744
      \uC54C\uACE0 \uACC4\uC2E0\uAC00\uC694?"
  - speaker: ???
    text: "\uB098\uAC00\uB294 \uAE38\uC774\uC694?"
  - speaker: ???
    text: "\uC774 \uB9C8\uC744\uC740 \uCC98\uC74C \uC624\uC168\uB098\uBD10\uC694."
  - speaker: "\uB098"
    text: "\uB124... \uB208 \uB5A0\uBCF4\uB2C8 \uB0AE\uC120 \uACF3\uC774\uB77C\uC11C\uC694."
  - speaker: ???
    text: "\uC800\uD76C \uB9C8\uC744\uC774 \uBCF5\uC7A1\uD558\uAE30\uB294 \uD558\uC8E0.
      \uC800\uB3C4 \uCC98\uC74C\uC5D0\uB294 \uB9CE\uC774 \uD5E4\uBA54\uC5C8\uC5B4\uC694."
  - speaker: ???
    text: "\uC800\uD76C \uB9C8\uC744\uC740 \uAE38\uC774 \uACE7 \uB098\uAC00\uB294
      \uBC29\uD5A5\uC774\uB77C\uC11C, \uAE38\uC744 \uB530\uB77C\uC11C \uAC78\uC5B4\uAC00\uC2DC\uBA74
      \uB3FC\uC694. "
  prompt: {fileID: 1814965652}
  dialogueBox: {fileID: 798264633}
