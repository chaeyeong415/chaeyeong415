  lines:
  - speaker: 
    text: "\uCC98\uC74C\uBCF4\uB294 \uD3B8\uC9C0\uC640 \uC120\uBB3C\uC774 \uB193\uC5EC\uC838
      \uC788\uB2E4."
  - speaker: "\uB098"
    text: "\uC774\uAC8C \uBB50\uC9C0...?"
  - speaker: "\uB098"
    text: "\uC77D\uC5B4\uBCFC\uAE4C..."
  - speaker: ???
    text: "\uC548\uB155, \uC624\uB298\uC774 \uB108\uC758 \uC0DD\uC77C\uC774\uC9C0?"
  - speaker: ???
    text: "\uC6B0\uB9AC\uAC00 \uB110 \uC704\uD574\uC11C \uD30C\uD2F0\uB97C \uC900\uBE44\uD588\uC5B4."
  - speaker: ???
    text: "\uB108\uC758 \uC0DD\uC77C \uD30C\uD2F0\uB2C8\uAE4C \uC8FC\uC778\uACF5\uC774
      \uBE60\uC9C0\uBA74 \uC548\uB418\uC796\uC544?"
  - speaker: ???
    text: "\uAF2D \uC640\uC8FC\uBA74 \uC88B\uACA0\uC5B4. \uC7A5\uC18C\uB294 \uB098\uC640\uC11C
      \uB9C8\uC744 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uBB3C\uC5B4\uBD10."
  - speaker: 
    text: "-\uB108\uC758 \uCE5C\uAD6C\uB4E4\uC774-"
  prompt: {fileID: 1964022853}
  dialogueBox: {fileID: 1511905755}
